    "/v1/public/enquiries": {
      "post": {
        "tags": [
          "website"
        ],
        "summary": "Enquiry",
        "description": "CT-01 enquiry desk (replaces `mailto:`). With a session token the enquiry joins that visit's deal;\nwithout one a Turnstile token is required. The CRM gets English labels (design doc \u00a76).",
        "operationId": "enquiry_v1_public_enquiries_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
