          "type": {
            "type": "string",
            "const": "add_to_enquiry",
            "title": "Type",
            "default": "add_to_enquiry"
          },
          "product_ids": {
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
