    "/v1/public/sessions/{session_id}/events": {
      "post": {
        "tags": [
          "website"
        ],
        "summary": "Event",
        "description": "The visitor moved on the site. Their place is saved; the assistant may nudge (rarely, and only\nafter the visitor has spoken: `website/service.py`).",
        "operationId": "event_v1_public_sessions__session_id__events_post",
        "parameters": [
