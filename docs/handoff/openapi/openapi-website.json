{
  "openapi": "3.1.0",
  "info": {
    "title": "Kairox website API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/public/sessions": {
      "post": {
        "tags": [
          "website"
        ],
        "summary": "Start",
        "description": "\u00a76 step 1: start a website conversation (Turnstile-checked).",
        "operationId": "start_v1_public_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/sessions/{session_id}/messages": {
      "post": {
        "tags": [
          "website"
        ],
        "summary": "Message",
        "description": "One chat turn (\u00a76 steps 2-6) through the same agents, guard and router as WhatsApp; the page\nmoves with it (D55). `Accept: text/event-stream` streams `action`, `delta`, `done` / `error`.",
        "operationId": "message_v1_public_sessions__session_id__messages_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              },
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/sessions/{session_id}/voice": {
      "post": {
        "tags": [
          "website"
        ],
        "summary": "Voice",
        "description": "A LiveKit room token for live voice (participant metadata: deal_ref, language, session_id).",
        "operationId": "voice_v1_public_sessions__session_id__voice_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
