{
  "info": {
    "name": "Kairox Website",
    "description": "Website API (kx.agents): the AI assistant's sessions, messages, events, contact and enquiries. Generated by scripts/gen_handoff.py from the code; read docs/handoff/WEBSITE_API.md. Pick the Kairox local or staging environment. No staff sign-in: request 1 saves the website session token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "buyer_text",
      "value": "Hi, I need 50,000 aluminium containers 750 ml with lids, delivery to Dubai."
    },
    {
      "key": "web_text",
      "value": "Hello, do you make aluminium food containers with lids?"
    },
    {
      "key": "wa_reuse_last_id",
      "value": "no"
    },
    {
      "key": "cms_operation",
      "value": "publish"
    },
    {
      "key": "cms_age_seconds",
      "value": "0"
    },
    {
      "key": "export_entity",
      "value": "deals"
    },
    {
      "key": "setting_value",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Health and keys",
      "description": "Is the server up? Run these first on every target.",
      "item": [
        {
          "name": "Health check (API up)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Liveness: the API process answers.\n\n**Who may call it:** public (monitoring)\n\n**Expected on success:** HTTP 200",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
