    {
      "name": "10 Buyer simulation - Website chat",
      "description": "Pretend to be a website visitor (public API, no staff login).",
      "item": [
        {
          "name": "1. Start a website chat session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/public/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "public",
                "sessions"
              ]
            },
            "description": "§6 step 1: start a website conversation (Turnstile-checked).\n\n**Who may call it:** A website visitor (Turnstile human check on staging/production)\n\n**Expected on success:** HTTP 201",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"turnstile_token\": \"{{turnstile_token}}\",\n  \"language\": \"en\",\n  \"voice_consent\": false,\n  \"cookie_consent\": true,\n  \"country_code\": \"AE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.environment.set(\"session_id\", d.session_id);",
                  "  pm.environment.set(\"session_token\", d.session_token);",
                  "  console.log(\"Website session started, language \" + d.language + \", voice available: \" + d.voice_available);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Visitor sends a chat message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/public/sessions/{{session_id}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "public",
                "sessions",
                "{{session_id}}",
                "messages"
              ]
            },
            "description": "One chat turn (§6 steps 2-6) through the same agents, guard and router as WhatsApp; the page moves with it (D55). `Accept: text/event-stream` streams `action`, `delta`, `done` / `error`.\n\n**Who may call it:** A website visitor: header Authorization: Bearer <session_token>\n\n**Expected on success:** HTTP 200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"{{web_text}}\",\n  \"language\": \"en\",\n  \"context\": {\n    \"path\": \"/products\",\n    \"page\": \"products\",\n    \"locale\": \"en\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{session_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  console.log(\"AI reply: \" + d.reply);",
                  "  pm.test(\"The reply never shows a price the backend did not build (check by eye)\", function () { pm.expect(d).to.have.property(\"reply\"); });",
                  "  pm.test(\"Site actions come as a list (D55)\", function () { pm.expect(d.actions).to.be.an(\"array\"); });",
                  "  (d.actions || []).forEach(function (a) { console.log(\"Page action: \" + a.type + \" \" + JSON.stringify(a.resolved)); });",
                  "}"
                ]
              }
            }
          ]
        },
