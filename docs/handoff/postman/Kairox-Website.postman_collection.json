            "description": "§6 step 7: the visitor typed their phone or email; a returning buyer is recognised now, never before. The answer does not say whether the buyer was known.\n\n**Who may call it:** A website visitor: header Authorization: Bearer <session_token>\n\n**Expected on success:** HTTP 200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{web_phone}}\",\n  \"email\": \"{{web_email}}\",\n  \"name\": \"QA Website Visitor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{session_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
