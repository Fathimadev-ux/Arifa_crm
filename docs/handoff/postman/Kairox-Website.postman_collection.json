  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Renew the 15-minute staff access token before it runs out (sign in once per 12 hours).",
          "(() => {",
          "  const path = pm.request.url.getPath();",
          "  if (path.startsWith('/v1/auth/') || !path.startsWith('/v1/') || path.startsWith('/v1/public/')) { return; }",
          "  const refresh = pm.environment.get('refresh_token');",
          "  if (!refresh) { return; }",
          "  const expiresAt = Number(pm.environment.get('access_expires_at') || 0);",
          "  if (pm.environment.get('access_token') && Date.now() < expiresAt - 60000) { return; }",
          "  pm.sendRequest({",
          "    url: pm.environment.get('base_url') + '/v1/auth/refresh', method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ refresh_token: refresh }) }",
          "  }, (err, res) => {",
          "    if (err || res.code !== 200) { console.warn('Session ended: sign in again (folder 01).'); return; }",
          "    const body = res.json();",
          "    pm.environment.set('access_token', body.access_token);",
          "    pm.environment.set('access_expires_at', String(Date.now() + body.expires_in * 1000));",
          "    const c = res.cookies && res.cookies.get('kx_refresh');",
          "    const next = c && c.value !== undefined ? c.value : c;",
          "    if (next) { pm.environment.set('refresh_token', next); }",
          "  });",
          "})();"
        ]
      }
    }
  ]
}
