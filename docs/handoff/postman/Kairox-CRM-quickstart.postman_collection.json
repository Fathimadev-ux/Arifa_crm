                "mfa",
                "totp"
              ]
            },
            "description": "Signed in with mfa=true (needed for approvals, price list, settings).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_token\": \"{{challenge_token}}\",\n  \"code\": \"{{mfa_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
