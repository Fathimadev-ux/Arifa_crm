+const refOf = (id: string) => ((catalogue as any).products || []).find((p) => p.id === id)?.ref || id;
+function toAction(actions: SiteAction[] | undefined) {
+  let out = null;
+  for (const a of actions || []) {
+    if (a.type === 'show_family' && a.family) out = { type: 'family', id: a.family };
+    else if (a.type === 'show_product' && a.product_id) out = { type: 'product', ref: refOf(a.product_id) };
+    else if (a.type === 'factory_tour') out = { type: 'factory' };
+    else if (a.type === 'fill_enquiry' && a.fill) {
+      const f = a.fill;
+      out = { type: 'quote', fill: { family: (f.family || [])[0] || '', quantity: f.quantity || '', city: f.city || '', notes: f.message || f.detail || '' } };
+    } else if ((a.type === 'navigate' || a.type === 'scroll_to') && a.resolved) {
+      out = { type: 'navigate', href: isArPage() ? a.resolved.path_ar : a.resolved.path_en };
+    }
+  }
+  return out;
+}
