+/** what the assistant asks the page to do (WEBSITE_API.md: checked against the site map, never a selector or a price) */
+export type SiteAction = {
+  id: string; type: string; layer: 'instant' | 'agent';
+  resolved?: { path_en: string; path_ar: string; anchor?: string | null } | null;
+  family?: string; product_id?: string; page?: string; section?: string | null; chapter?: string | null;
+  product_ids?: string[]; fill?: Record<string, any>;
+};
+export type MessageOut = { reply: string | null; language: string; handed_over: boolean; actions?: SiteAction[] };
+
+/** where the visitor is (SiteContext): sent with every message so the assistant knows the page */
+export function siteContext() {
+  const ar = location.pathname === '/ar' || location.pathname.startsWith('/ar/');
+  const p = ar ? location.pathname.slice(3) || '/' : location.pathname;
+  const seg = p.split('/').filter(Boolean);
+  const pages = ['products', 'about', 'quality', 'clients', 'contact'];
+  const page = seg.length === 0 ? 'home' : seg[0] === 'products' && seg[1] ? 'product' : pages.includes(seg[0]) ? seg[0] : 'other';
+  const q = new URLSearchParams(location.search);
+  const id = (v: string | null) => (v && /^[a-z0-9][a-z0-9_-]{0,127}$/.test(v) ? v : null);
+  return {
+    path: (location.pathname + location.search).slice(0, 300),
+    page,
+    locale: ar ? 'ar' : 'en',
+    family: id(q.get('family')),
+    product_id: page === 'product' ? id(seg[1]) : null,
+    quick_view_id: id(q.get('p')),
+    input: 'text',
+  };
+}
